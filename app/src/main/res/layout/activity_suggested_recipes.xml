<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF5FA"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="48dp"
    android:paddingBottom="24dp">

    <!-- Back to Home -->
    <Button
        android:id="@+id/buttonBackHome"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="←"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="15sp"
        android:background="@drawable/pink_button_background"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:layout_marginBottom="22dp" />

    <!-- Page title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Suggested Recipes 🍳"
        android:textSize="27sp"
        android:textStyle="bold"
        android:textColor="#9C27B0"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipes you can make with what you have 💚"
        android:textSize="15sp"
        android:textColor="#8E6A8F"
        android:gravity="center"
        android:layout_marginBottom="22dp" />

    <!-- No recipes message -->
    <TextView
        android:id="@+id/textViewNoRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No recipes match your pantry yet.\nAdd more ingredients to discover recipes!"
        android:textSize="17sp"
        android:textColor="#8E6A8F"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_marginTop="30dp" />

    <!-- Suggested recipes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="10dp" />

</LinearLayout>