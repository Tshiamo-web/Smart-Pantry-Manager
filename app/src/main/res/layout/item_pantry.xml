<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/pantry_item_background"
    android:elevation="4dp">

    <TextView
        android:id="@+id/textViewItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Item Name"
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="#5A315D" />

    <TextView
        android:id="@+id/textViewItemQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quantity"
        android:textSize="16sp"
        android:textColor="#6D526F"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/textViewItemExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Expiry Date"
        android:textSize="16sp"
        android:textColor="#6D526F"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/textViewExpiryStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Expiry Status"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/buttonEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit ✏️"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#E88BB5" />

        <Button
            android:id="@+id/buttonDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Delete 🗑️"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#D96C9D" />

    </LinearLayout>

</LinearLayout>