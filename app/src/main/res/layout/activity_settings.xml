<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <Button
            android:id="@+id/buttonBackHome"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="← "
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="@drawable/pink_button_background"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:layout_marginBottom="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings ⚙️"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#9C27B0"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About your Smart Pantry Manager 💗"
            android:textSize="15sp"
            android:textColor="#8E6A8F"
            android:gravity="center"
            android:layout_marginBottom="26dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/pantry_item_background"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📱 App Information"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#AB5A7E"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smart Pantry Manager helps you organise your pantry, manage ingredients and discover recipes using what you already have."
                android:textSize="15sp"
                android:textColor="#5F4B5F"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/pantry_item_background"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🗄️ Database"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#AB5A7E"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SQLite is used to store pantry items and recipes locally on the device. Your pantry data remains available after closing and reopening the app."
                android:textSize="15sp"
                android:textColor="#5F4B5F"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/pantry_item_background"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🍳 Recipe Suggestions"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#AB5A7E"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recipes are suggested only when all required ingredients and quantities are available in your pantry."
                android:textSize="15sp"
                android:textColor="#5F4B5F"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/pantry_item_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ️ Version"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#AB5A7E"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smart Pantry Manager • Mobile Application Development 700"
                android:textSize="15sp"
                android:textColor="#5F4B5F"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>