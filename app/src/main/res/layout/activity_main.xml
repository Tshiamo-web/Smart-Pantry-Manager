<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFF5FA"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFF5FA"
        android:elevation="4dp"
        app:title="Smart Pantry Manager"
        app:titleTextColor="#9C27B0"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <!-- Main title -->
    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart Pantry Manager"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#9C27B0"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@+id/textViewSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Small subtitle -->
    <TextView
        android:id="@+id/textViewSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Organise • Track • Enjoy"
        android:textSize="15sp"
        android:textColor="#8E6A8F"
        android:layout_marginTop="18dp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewTitle" />

    <!-- Decorative pantry illustration -->
    <TextView
        android:id="@+id/textViewPantryIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🧺  🥫  🍎  🥛"
        android:textSize="38sp"
        android:gravity="center"
        android:layout_marginTop="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewSubtitle" />

    <!-- Open Pantry button -->
    <Button
        android:id="@+id/buttonOpenPantry"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:layout_marginTop="28dp"
        android:text="Open Pantry"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="17sp"
        android:background="@drawable/pink_button_background"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewPantryIcon" />

    <!-- View Pantry button -->
    <Button
        android:id="@+id/buttonViewPantry"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:layout_marginTop="14dp"
        android:text="View Pantry"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="17sp"
        android:background="@drawable/pink_button_background"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonOpenPantry" />

    <!-- Suggested Recipes button -->
    <Button
        android:id="@+id/buttonSuggestedRecipes"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:layout_marginTop="14dp"
        android:text="Suggested Recipes 🍳"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="17sp"
        android:background="@drawable/pink_button_background"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonViewPantry" />

    <Button
        android:id="@+id/buttonSettings"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:layout_marginTop="14dp"
        android:text="Settings ⚙️"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="17sp"
        android:background="@drawable/pink_button_background"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonSuggestedRecipes" />
</androidx.constraintlayout.widget.ConstraintLayout>
